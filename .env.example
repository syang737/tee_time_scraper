# Copy to .env and fill in. Never commit .env.

# Password for the web GUI (single shared password).
GUI_PASSWORD=change-me

# Secret used to sign the session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string

# Default ntfy.sh topic, used by any watch that doesn't set its own. Pick
# something unguessable -- anyone who knows the topic name can read your
# alerts. Subscribe to the same topic in the ntfy app on your phone.
#
# Each watch can override this in the GUI, which is how several people share
# one instance and each get only their own alerts.
NTFY_TOPIC=teetimes-change-me-to-something-random

# ntfy server. Leave as-is for the free public one.
NTFY_SERVER=https://ntfy.sh

# How often to poll the ForeUp API, in seconds.
POLL_INTERVAL_SECONDS=30

# Minutes to wait before re-notifying about a slot that is still open.
RENOTIFY_AFTER_MINUTES=10

# Pause between individual requests within one poll cycle, so a watch
# covering several courses and dates trickles rather than bursts.
REQUEST_DELAY_SECONDS=0.5

# Where the SQLite database lives.
DB_PATH=teetimes.db

# Drop slot history not seen for this many days. Purged once a day, then the
# file is VACUUMed. Anything still open keeps being seen, so it is never
# purged -- this only ages out slots the poller has stopped finding.
RETENTION_DAYS=5

# Set to true when serving over HTTPS (behind Caddy) so the session cookie is
# never sent over a plain connection. Leave unset for local http development.
COOKIE_SECURE=

# --- Union County (EZLinks) -------------------------------------------------
# Union is behind Cloudflare, which rejects on TLS fingerprint rather than
# headers. curl_cffi replays a real Chrome handshake; set empty to force
# plain httpx (which will usually be challenged). Try another build, e.g.
# chrome131, if the default stops working.
EZLINKS_IMPERSONATE=chrome124

# Minimum gap between Union requests, on top of the poll interval. Polling a
# Cloudflare-fronted endpoint as hard as the open ones invites a block.
EZLINKS_MIN_INTERVAL_SECONDS=120

# --- Bergen County (CPS Golf) -----------------------------------------------
# Pricing class the search runs under. County cardholders may see different
# times and prices than the "NON" (non-resident) default.
CPS_CLASS_CODE=NON
